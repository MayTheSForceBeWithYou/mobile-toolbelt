{
  "name": "mobile-toolbelt",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform mobile app automation CLI monorepo",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "pnpm --filter @mobile-toolbelt/cli dev",
